# ─────────────────────────────────────────────────────────────────────────────
# INSECAP Capacitaciones – Variables de entorno
# Copia este archivo como `.env.local` (desarrollo) o `.env.production` (prod)
# y rellena los valores según el entorno.
# NUNCA subas a git los archivos .env, .env.local ni .env.production.
# ─────────────────────────────────────────────────────────────────────────────

# ── TMS Plus API (formulario de cursos abiertos / contacto) ─────────────────
# URL base del nuevo TMS (TMS Plus) para las llamadas del frontend.
# • En LOCAL: dejar vacío para que Vite use el proxy inverso definido en vite.config.ts
VITE_TMS_PLUS_API_URL=

# Target del proxy de Vite para /api/contacto (solo desarrollo local).
TMS_PLUS_PROXY_TARGET=

# ── Simuladores ─────────────────────────────────────────────────────────────
# Si es false, no se muestra la seccion en Home ni existe la ruta /simuladores.
# Valores válidos: true | false
VITE_SIMULATORS_ENABLED=false

# ── Noticias ────────────────────────────────────────────────────────────────
# El modulo de noticias consume /api/publica/noticias desde el TMS PLUS.
# Usa VITE_TMS_PLUS_API_URL (frontend) y TMS_PLUS_PROXY_TARGET (proxy de Vite
# en local). No necesita variables propias.

VITE_URL_APPSTORE=https://apps.apple.com/cl/app/relatoresya/id6742147110
VITE_URL_PLAYSTORE=https://play.google.com/store/apps/details?id=com.insecap.relatoresya&pcampaignid=web_share

# Burbuja de Capin (chat de cursos): llama directo al RAG-service de Capin en modo público
# (POST /chat sin API key; solo nombre y horas de los cursos). CORS y límite viven en Capin.
VITE_CAPIN_CHAT_ENABLED=false
# Producción: https://rag.insecap.cl (POST /chat sin X-Api-Key = modo público; un GET da 405).
VITE_CAPIN_API_URL=
# Solo dev: proxy de Vite /capin → Capin local (uvicorn).
CAPIN_PROXY_TARGET=http://localhost:8000
