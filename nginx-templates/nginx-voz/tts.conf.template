# Voz de la vista /forede: POST /tts reenvía una frase a ElevenLabs con la clave del servidor.
# Plantilla: la entrada de la imagen de nginx la copia a /tmp/nginx-voz/tts.conf al arrancar,
# reemplazando ${ELEVENLABS_API_KEY} y ${ELEVENLABS_VOICE_ID} (Dockerfile: NGINX_ENVSUBST_*).
# El cuerpo es el de ElevenLabs ({"text", "model_id", "language_code"}): lo arma
# src/components/capin/api.ts.
location = /tts {
    limit_except POST { deny all; }
    limit_req zone=voz burst=20 nodelay;
    limit_req_status 429;
    client_max_body_size 2k;
    client_body_buffer_size 2k;

    # Sin clave (CI, local sin secreto): 503 y la vista sigue en texto.
    set $voz_clave "${ELEVENLABS_API_KEY}";
    if ($voz_clave = "") {
        return 503;
    }

    # Con variable, el nombre se resuelve en cada pedido: si el DNS falla al arrancar, el sitio
    # levanta igual (sin ella, nginx no inicia si no resuelve api.elevenlabs.io).
    resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
    resolver_timeout 5s;
    set $voz_destino "https://api.elevenlabs.io/v1/text-to-speech/${ELEVENLABS_VOICE_ID}/stream?output_format=mp3_44100_64";
    proxy_pass $voz_destino;
    proxy_ssl_server_name on;
    proxy_ssl_name api.elevenlabs.io;
    proxy_http_version 1.1;

    # A ElevenLabs solo va lo necesario: ni cookies ni cabeceras del visitante.
    proxy_pass_request_headers off;
    proxy_set_header Host api.elevenlabs.io;
    proxy_set_header xi-api-key $voz_clave;
    proxy_set_header Content-Type application/json;
    proxy_set_header Accept audio/mpeg;

    # El audio sale a medida que llega.
    proxy_buffering off;
    proxy_hide_header Set-Cookie;
    proxy_hide_header Access-Control-Allow-Origin;
}
